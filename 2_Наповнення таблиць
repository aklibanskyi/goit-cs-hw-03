import random
import psycopg2
from faker import Faker

DB_CONFIG = {
    "dbname": "task_manager_db",
    "user": "postgres",
    "password": "your_password",
    "host": "localhost",
    "port": 5432
}

fake = Faker()

def seed_database():
    conn = None
    try:
        conn = psycopg2.connect(**DB_CONFIG)
        with conn.cursor() as cur:
            # 1. Заповнення статусів
            statuses = [('new',), ('in progress',), ('completed',)]
            cur.executemany(
                "INSERT INTO status (name) VALUES (%s) ON CONFLICT (name) DO NOTHING;",
                statuses
            )

            # Отримуємо ID збережених статусів
            cur.execute("SELECT id FROM status;")
            status_ids = [row[0] for row in cur.fetchall()]

            # 2. Заповнення користувачів
            user_ids = []
            for _ in range(15):
                fullname = fake.name()
                email = fake.unique.email()
                cur.execute(
                    "INSERT INTO users (fullname, email) VALUES (%s, %s) RETURNING id;",
                    (fullname, email)
                )
                user_ids.append(cur.fetchone()[0])

            # 3. Заповнення завдань
            assigned_users = user_ids[:10]

            for _ in range(30):
                title = fake.sentence(nb_words=4)
                # Частина завдань буде без опису (NULL), для перевірки відповідного запиту
                description = fake.text(max_nb_chars=150) if random.random() > 0.25 else None
                status_id = random.choice(status_ids)
                user_id = random.choice(assigned_users)

                cur.execute(
                    """
                    INSERT INTO tasks (title, description, status_id, user_id)
                    VALUES (%s, %s, %s, %s);
                    """,
                    (title, description, status_id, user_id)
                )

            conn.commit()
            print("Базу даних успішно заповнено тестовими даними!")

    except Exception as error:
        if conn:
            conn.rollback()
        print(f"Помилка при заповненні бази даних: {error}")
    finally:
        if conn:
            conn.close()

if __name__ == "__main__":
    seed_database()
